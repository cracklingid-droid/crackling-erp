generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Semua tabel HR sengaja diberi prefix "Hr" - Crackling ERP numpang di
// database Postgres yang sama dengan Crackling Warehouse (satu instance
// Neon, hemat provisioning), tapi sistem akun & datanya harus benar-benar
// terpisah (keputusan Kevin 2026-09-10: "sistem akun baru terpisah").
// Prefix ini menghindari tabrakan nama tabel & memudahkan lihat mana punya
// modul mana langsung dari nama tabelnya.
model HrUser {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  // 'owner' | 'developer' | 'hr_manager' | 'hr_staff' - owner & developer
  // selalu dibuatkan akun di sini juga (permintaan Kevin 2026-09-10), biar
  // akses penuh ke semua modul ERP termasuk HR tanpa perlu akun kedua.
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  jobPostingsCreated           JobPosting[]
  candidatesCreated            Candidate[]
  stageEvents                  CandidateStageEvent[]
  employeesCreated             Employee[]
  payrollPeriodsCreated        PayrollPeriod[]
  employeeHistoryEntries       EmployeeHistoryEntry[]
  rosterEntriesCreated         RosterEntry[]
  payrollEventNotesCreated     PayrollEventNote[]
  attendanceNameAliasesCreated AttendanceNameAlias[]
  overtimeManagerDecisions     OvertimeRequest[]      @relation("OvertimeManagerDecision")
  overtimeHrDecisions          OvertimeRequest[]      @relation("OvertimeHrDecision")
  journalEntriesCreated        JournalEntry[]
  directExpensesCreated        DirectExpense[]
  invoicesCreated              Invoice[]              @relation("InvoiceCreatedBy")
  invoicesPaid                 Invoice[]              @relation("InvoicePaidBy")
  invoicePricesUpdated         InvoiceItemPrice[]     @relation("InvoicePriceUpdatedBy")
}

// Posisi kerja (mis. "Waiters", "Kitchen Staff") - dipisah dari JobPosting
// karena posisi yang sama sering dibuka-tutup berkali-kali di F&B (permintaan
// Kevin 2026-09-10), sementara bank soal psikotest & nilai ambang batasnya
// mau tetap sama tiap kali posisi itu dibuka lagi, tidak usah diketik ulang.
model Position {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  // ambang lulus psikotest dalam persen (0-100) dari skor maksimum posisi ini
  passingScore         Int      @default(70)
  // tampilkan checklist syarat & ketentuan khusus dapur (B2, shift 12 jam,
  // pinjol) di form lamaran publik - permintaan Kevin 2026-09-10.
  requiresKitchenTerms Boolean  @default(false)
  // posisi kantor/office (bukan outlet) - lokasi/cabang di form lamaran jadi
  // teks bebas, bukan dropdown 3 outlet tetap. Permintaan Kevin 2026-09-10.
  isOfficePosition     Boolean  @default(false)
  createdAt            DateTime @default(now())

  questions   PsychTestQuestion[]
  jobPostings JobPosting[]
}

model PsychTestQuestion {
  id         Int      @id @default(autoincrement())
  positionId Int
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  text       String
  createdAt  DateTime @default(now())

  options PsychTestOption[]
  answers PsychTestAnswer[]
}

model PsychTestOption {
  id         Int               @id @default(autoincrement())
  questionId Int
  question   PsychTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  // poin kontribusi ke skor total kalau opsi ini dipilih pelamar
  score      Int               @default(0)
  order      Int               @default(0)

  answers PsychTestAnswer[]
}

model JobPosting {
  id             Int      @id @default(autoincrement())
  title          String
  positionId     Int
  position       Position @relation(fields: [positionId], references: [id])
  department     String? // outlet/divisi yang butuh, mis. "Kitchen - Joglo"
  location       String?
  employmentType String? // full-time | part-time | contract | magang
  description    String?
  status         String   @default("open") // open | closed
  createdById    Int
  createdBy      HrUser   @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  candidates Candidate[]
}

model Candidate {
  id           Int        @id @default(autoincrement())
  jobPostingId Int
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])
  // token acak buat pelamar akses halaman psikotest & jadwal interview
  // miliknya sendiri tanpa perlu login (pelamar publik, bukan staff).
  publicToken  String     @unique @default(uuid())
  name         String
  email        String?
  phone        String?
  source       String? // referral | job portal | walk-in | dst
  notes        String?

  // biodata diri lengkap - diisi pelamar sendiri lewat form publik
  birthPlace      String?
  birthDate       DateTime?
  gender          String? // L | P
  address         String?
  preferredOutlet String? // lokasi/cabang yang diinginkan
  lastEducation   String? // SMA/SMK | D3 | S1 | dst
  institution     String? // nama sekolah/kampus & jurusan
  experience      String? // pengalaman kerja terakhir, mis. "Cook - Hotel ABC"
  expectedSalary  Int? // ekspektasi gaji dalam rupiah
  cvUrl           String? // link file CV yang diupload ke Vercel Blob
  cvTextPreview   String? // teks hasil ekstraksi CV (PDF/DOCX) untuk dibaca HR

  // persetujuan syarat & ketentuan khusus dapur (hanya diisi kalau posisi
  // lowongannya requiresKitchenTerms) - permintaan Kevin 2026-09-10.
  agreedB2        Boolean @default(false)
  agreedLongShift Boolean @default(false)
  agreedNoPinjol  Boolean @default(false)
  // kesediaan mulai psikotest dalam 30 menit - wajib untuk semua pelamar,
  // permintaan Kevin 2026-09-10.
  agreedStartSoon Boolean @default(false)

  // 2 syarat yang harus HR selesaikan di tahap "offer" sebelum kandidat
  // boleh dipindah ke "hired" - surat penawaran/kontrak sudah dibuat, dan
  // sudah dikonfirmasi ke kandidat lewat WA. Permintaan Kevin 2026-09-10.
  offerDocumentReady Boolean @default(false)
  offerWhatsappSent  Boolean @default(false)

  // applied -> screening (lolos psikotest) -> interview -> offer -> hired -> rejected
  stage       String   @default("applied")
  // null kalau pelamar publik daftar sendiri (tanpa login), terisi kalau
  // dibuatkan manual oleh staff HR.
  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stageEvents         CandidateStageEvent[]
  psychTestSubmission PsychTestSubmission?
  interviewSlot       InterviewSlot?
  employee            Employee?

  @@index([jobPostingId, stage])
}

// Database Karyawan - terpisah dari Candidate karena field-nya beda konteks
// (kepegawaian/gaji/legal, bukan lamaran) dan siklus hidupnya lebih panjang
// (karyawan lama yang tidak pernah lewat pipeline rekrutmen juga harus bisa
// didata di sini). Permintaan Kevin 2026-09-10.
model Employee {
  id Int @id @default(autoincrement())

  // Terisi otomatis begitu kandidat dipindah ke tahap "Diterima" di
  // Rekrutmen (biodata dicopy dari situ) - null kalau karyawan lama/input
  // manual yang tidak lewat pipeline rekrutmen. Permintaan Kevin
  // 2026-09-10: "otomatis namun nanti sebelum onboard ada kewajiban
  // memasukan kelengkapan data" - makanya statusnya mulai dari "onboarding",
  // bukan langsung "active".
  candidateId Int?       @unique
  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  employeeCode String?   @unique // ID/kode karyawan internal (opsional), diisi HR
  ktpNumber    String? // No. KTP/NIK kependudukan (16 digit) - beda dari employeeCode
  name         String
  email        String?
  phone        String?
  birthPlace   String?
  birthDate    DateTime?
  gender       String? // L | P
  address      String?

  position         String? // jabatan
  outlet           String? // lokasi/cabang kerja
  employmentStatus String? // tetap | kontrak | pkwt | magang
  joinDate         DateTime?
  resignDate       DateTime?
  // onboarding (baru masuk, kelengkapan data belum diisi HR) -> active -> resigned
  status           String    @default("onboarding")

  baseSalary        Int? // gaji pokok bulanan, dalam rupiah
  allowance         Int?    @default(0) // tunjangan tetap bulanan
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?

  // Khusus kalkulator Payroll Outlet (permintaan Kevin 2026-09-11, ikut
  // logika spreadsheet gaji outlet yang sudah berjalan): Uang Transport &
  // Uang Makan dihitung per hari BENAR-BENAR hadir (bukan gaji pokok, yang
  // dibayar penuh apapun kehadirannya), dan "hari kerja standar" beda-beda
  // per karyawan (dipakai basis hitung rate lembur/telat).
  dailyTransportRate Int? // Uang Transport per hari hadir, dalam rupiah
  dailyMealRate      Int? // Uang Makan per hari hadir, dalam rupiah (dipakai jg utk "Uang Makan" Kantor - konsep sama, kategori tidak pernah dobel)
  standardWorkDays   Int? // "Day Work" - jumlah hari kerja standar per bulan

  // Khusus kalkulator Payroll Kantor (permintaan Kevin 2026-09-13, ikut
  // logika spreadsheet gaji kantor "2608 rekap gaji FINAL.xlsx" yang sudah
  // berjalan) - BEDA dari Outlet: Gaji Pokok dibayar PENUH (tidak
  // diprorata dari hari hadir), lembur dihitung per JAM dgn rate tetap
  // (bukan turunan Uang Makan/3 spt Outlet), Keterlambatan & Absen Tidak
  // Lengkap dihitung otomatis dari absensi vs workSchedule x rate ini. 3
  // angka BPJS di bawah nominal TETAP per bulan (bukan hasil rumus BPJS
  // umum - angka kebijakan perusahaan sendiri, bukan rumus) - "Kewajiban
  // BPJS Ktr" MENAMBAH gross (bukan mengurangi), sesuai spreadsheet asli
  // (sudah dikonfirmasi Kevin, kedengaran ganjil tapi memang begitu).
  kantorOvertimeRate           Int? // Lembur per JAM (kantor)
  kantorLateRate               Int? // Potongan Keterlambatan per kejadian (kantor)
  kantorIncompleteClockRate    Int? // Potongan Absen Tidak Lengkap per kejadian (kantor) - 1 rate dipakai utk Clock In maupun Clock Out
  kantorFuelRatePerKm          Int? // Reimburse Bensin per KM ditempuh (kantor) - KM diinput manual per periode, TIDAK termasuk Take Home Pay
  kantorBpjsAllowance          Int? // Tunjangan BPJS Kar - nominal tetap/bulan (kantor), penambah
  kantorBpjsEmployerObligation Int? // Kewajiban BPJS Ktr - nominal tetap/bulan (kantor), penambah
  kantorBpjsRemittance         Int? // Setoran ke BPJS - nominal tetap/bulan (kantor), pengurang

  // Karyawan part time digaji per hari (bukan gaji pokok bulanan) - dipisah
  // dari baseSalary supaya jelas beda skema, mis. Ridho/Wise yang gajinya
  // Rp150.000/hari, bukan gaji bulanan diprorata. Permintaan Kevin
  // 2026-09-11.
  dailyBaseRate Int? // gaji harian (part time), dalam rupiah

  // Deposit wajib karyawan kontrak: Rp250rb dipotong otomatis di 2 periode
  // gaji Outlet pertama sejak join (tanggal 10), berhenti sendiri setelah
  // 2x. Saldo naik/turun otomatis mengikuti field "Bayar Deposit"/"Kembali
  // Deposit" per PayrollItem, jadi selalu mencerminkan deposit yang masih
  // ditahan - dasar keputusan HR saat karyawan resign. Permintaan Kevin
  // 2026-09-11.
  depositInstallmentsPaid Int @default(0) // sudah dipotong berapa kali otomatis (maks 2)
  depositBalance          Int @default(0) // saldo deposit kontrak yang masih ditahan, dalam rupiah

  workSchedule String? // jadwal jam kerja standar, mis. "08:00-20:00" - dipakai di Rincian Perhitungan

  // Hari libur rutin mingguan (0=Minggu..6=Sabtu, ikut JS Date.getDay()) -
  // dipakai Roster utk otomatis isi Masuk/Libur tiap buka minggu baru, biar
  // HR tidak perlu klik satu-satu tiap minggu. Kosong = tidak ada pola,
  // roster tetap kosong seperti biasa. Permintaan Kevin 2026-09-11.
  defaultOffDays Int[] @default([])

  npwp                      String?
  bpjsKesehatanNumber       String?
  bpjsKetenagakerjaanNumber String?

  photoUrl String? // foto profil (Vercel Blob) - permintaan Kevin 2026-09-12

  // Tanggal akhir kontrak/PKWT yang berlaku saat ini - dipakai reminder
  // "Segera Jatuh Tempo" di Database Karyawan (H-30). Beda dari resignDate
  // (itu tanggal karyawan benar-benar keluar). Permintaan Kevin 2026-09-12.
  contractEndDate DateTime?

  // Atasan langsung - dipakai utk lihat siapa lapor ke siapa per outlet.
  // Optional & self-relation, jadi kalau atasannya dihapus dari sistem
  // field ini otomatis null (bukan ikut terhapus). Permintaan Kevin
  // 2026-09-12.
  reportsToId   Int?
  reportsTo     Employee?  @relation("EmployeeReportsTo", fields: [reportsToId], references: [id])
  directReports Employee[] @relation("EmployeeReportsTo")

  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents             EmployeeDocument[]
  attendanceRecords     AttendanceRecord[]
  payrollItems          PayrollItem[]
  historyEntries        EmployeeHistoryEntry[]
  rosterEntries         RosterEntry[]
  payrollEventNotes     PayrollEventNote[]
  attendanceNameAliases AttendanceNameAlias[]
  overtimeRequests      OvertimeRequest[]
}

// Riwayat perubahan jabatan/outlet/status kepegawaian/gaji - dicatat
// otomatis tiap kali HR mengubah salah satu field ini lewat form edit
// karyawan (bukan fitur tambah-manual terpisah), tapi HR tetap isi tanggal
// efektif & keterangan saat itu juga. Satu baris = satu field yang berubah
// dalam 1x simpan (kalau jabatan & gaji berubah bersamaan jadi 2 baris,
// masing-masing dgn note yang sama) - permintaan Kevin 2026-09-11.
model EmployeeHistoryEntry {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  field    String // position | outlet | employmentStatus | baseSalary | allowance
  oldValue String?
  newValue String?

  effectiveDate DateTime // kapan perubahan ini berlaku (bisa beda dari createdAt kalau dicatat belakangan)
  note          String? // mis. "promosi ke Supervisor", "kenaikan gaji tahunan"

  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

// Dokumen kepegawaian (KTP, ijazah, kontrak kerja, dst) - dipisah jadi tabel
// sendiri (bukan 1 kolom per jenis dokumen) supaya jumlah & jenisnya bebas
// menyesuaikan kebutuhan tiap karyawan, sama pola-nya dengan cvUrl di
// Candidate tapi mendukung banyak file.
model EmployeeDocument {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // ktp | ijazah | kontrak_kerja | lainnya
  fileUrl    String
  fileName   String?
  expiryDate DateTime? // opsional - dipakai reminder "Segera Jatuh Tempo" (mis. kontrak kerja, SIM)
  uploadedAt DateTime  @default(now())
}

// Pengajuan lembur - HANYA utk karyawan posisi SPV (deteksi otomatis dari
// kata "SPV" di Employee.position, permintaan Kevin 2026-09-14), diajukan
// sendiri lewat Portal Karyawan. Foto lampiran WAJIB (bukti/alasan
// pekerjaan yang perlu dikerjakan lembur) - tanpa foto tidak bisa
// disubmit. Approval 2 tahap berurutan: role "manager" dulu (akun global
// yang sama dgn manager Cost Center/Warehouse), baru HR (owner/developer/
// hr_manager/hr_staff) - kalau salah satu tolak, langsung berhenti di situ
// (tidak lanjut ke tahap berikutnya). SENGAJA TIDAK mempengaruhi
// perhitungan gaji lembur - itu tetap otomatis dari data absensi asli
// (lib/payroll-outlet-calc.ts / lib/payroll-kantor-calc.ts) - pengajuan
// ini murni syarat administratif/izin sebelum boleh lembur, bukan sumber
// angka jam lembur yang dibayar (keputusan Kevin 2026-09-14).
model OvertimeRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date     DateTime // tanggal rencana lembur
  reason   String // keterangan alasan perlu lembur
  photoUrl String // wajib - foto pekerjaan yang jadi alasan lembur

  status String @default("pending_manager") // pending_manager | pending_hr | approved | rejected

  managerDecision     String? // "approved" | "rejected"
  managerDecisionAt   DateTime?
  managerDecisionById Int?
  managerDecisionBy   HrUser?   @relation("OvertimeManagerDecision", fields: [managerDecisionById], references: [id])
  managerNote         String?

  hrDecision     String? // "approved" | "rejected"
  hrDecisionAt   DateTime?
  hrDecisionById Int?
  hrDecisionBy   HrUser?   @relation("OvertimeHrDecision", fields: [hrDecisionById], references: [id])
  hrNote         String?

  createdAt DateTime @default(now())

  @@index([employeeId, date])
  @@index([status])
}

model PsychTestSubmission {
  id          Int       @id @default(autoincrement())
  candidateId Int       @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  totalScore  Int
  maxScore    Int
  percentage  Int
  passed      Boolean
  submittedAt DateTime  @default(now())

  answers PsychTestAnswer[]
}

model PsychTestAnswer {
  id           Int                 @id @default(autoincrement())
  submissionId Int
  submission   PsychTestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     PsychTestQuestion   @relation(fields: [questionId], references: [id])
  optionId     Int
  option       PsychTestOption     @relation(fields: [optionId], references: [id])
  score        Int
}

// Slot interview 13.30-16.00 tiap 15 menit, berulang tiap hari kerja -
// dihitung on-the-fly di kode, tabel ini cuma nyimpen slot yang SUDAH
// dipilih pelamar (permintaan Kevin 2026-09-10).
model InterviewSlot {
  id          Int       @id @default(autoincrement())
  candidateId Int       @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  scheduledAt DateTime  @unique
  createdAt   DateTime  @default(now())
}

// Jejak tiap kali kandidat pindah tahap - biar kelihatan riwayat & siapa
// yang memindahkan, bukan cuma status terakhir.
model CandidateStageEvent {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  stage       String
  note        String?
  // null kalau perpindahan tahap otomatis (pelamar publik daftar sendiri,
  // psikotest dinilai sistem, atau interview dijadwalkan sendiri oleh
  // pelamar) - tidak ada staff HR yang melakukannya secara manual.
  createdById Int?
  createdBy   HrUser?   @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

// Rekap absensi harian per karyawan, hasil import dari file export mesin
// fingerprint/absensi digital - permintaan Kevin 2026-09-11 utk fitur
// Payroll (dasar hitung uang makan, lembur, & potongan absensi). Satu baris
// per karyawan per tanggal; kalau file sumbernya berupa log scan mentah
// (banyak baris per hari), scan pertama & terakhir diambil sbg clockIn/Out
// saat import (lihat lib/attendance-parse.ts).
model AttendanceRecord {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // tengah malam (tanpa jam) - tanggal absensi
  clockIn    DateTime?
  clockOut   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
}

// Alias nama mesin absensi -> karyawan - dibuat otomatis begitu HR
// konfirmasi saran pencocokan nama mirip saat upload absensi (mis. mesin
// fingerprint tulis "ahmad", tapi Database Karyawan "Ahmad Yani"). Sekali
// dikonfirmasi, upload berikutnya langsung otomatis kebaca tanpa perlu
// dikonfirmasi ulang. machineName disimpan trim+lowercase (normalized),
// berlaku global lintas outlet (1 nama mesin = 1 karyawan tertentu, tidak
// dibedakan per outlet - keputusan Kevin 2026-09-12, nama karyawan
// Crackling cukup unik antar outlet).
model AttendanceNameAlias {
  id          Int      @id @default(autoincrement())
  machineName String   @unique
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Roster kerja mingguan per outlet - cuma "masuk" atau "libur" per karyawan
// per tanggal (bukan jam shift), ditampilkan sbg 1 papan bersama per outlet
// yang bisa dibuka siapa saja lewat link publik tanpa login (permintaan
// Kevin 2026-09-11: "roster ini bisa dilihat langsung", 1 papan per outlet
// bukan link personal per karyawan).
model RosterEntry {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // tengah malam (tanpa jam)
  isWorking  Boolean  @default(true) // true = masuk, false = libur

  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// Satu periode/batch perhitungan gaji - dipisah "outlet" vs "kantor" krn
// komponen & cara hitungnya beda (permintaan Kevin 2026-09-11): outlet
// berbasis gaji pokok + potongan/tunjangan dari absensi, kantor tambah
// reimbursement transport. Status "final" menandakan periode itu sudah
// tidak boleh diubah lagi (sudah dibayarkan).
model PayrollPeriod {
  id          Int      @id @default(autoincrement())
  label       String // mis. "Gaji September 2026"
  startDate   DateTime
  endDate     DateTime
  category    String // outlet | kantor
  status      String   @default("draft") // draft | final
  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items      PayrollItem[]
  eventNotes PayrollEventNote[]

  @@index([category, startDate])
}

// Catatan kejadian/telat/SP per tanggal per karyawan dalam 1 periode gaji -
// mis. "03 Agu - Pengurangan Dari Kejadian Rp15.000 - Hekeng Rusak". Tiap
// catatan otomatis menambah field potongan terkait di PayrollItem (lihat
// route notes), supaya HR tetap bisa lihat angka total di tabel periode
// SEKALIGUS rincian tanggal & alasannya di halaman Rincian Perhitungan -
// dipelajari dari sheet "Hitungan" Kevin. Permintaan Kevin 2026-09-11.
model PayrollEventNote {
  id         Int           @id @default(autoincrement())
  periodId   Int
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee      @relation(fields: [employeeId], references: [id])
  date       DateTime
  category   String // kejadian | sp | keterlambatan
  amount     Int
  note       String?

  createdById Int?
  createdBy   HrUser?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([periodId, employeeId])
}

// Rincian gaji 1 karyawan dalam 1 periode. Field yang bisa dihitung
// otomatis dari absensi (uang makan, lembur) diisi sbg SARAN saat periode
// dibuat, tapi tetap bisa diedit HR - begitu juga PPh21 & kasbon yang
// sengaja dibuat manual dulu (perhitungan pajak & kasbon butuh data/aturan
// yang belum ada di sistem). Nominal gaji bersih dihitung on-the-fly di
// kode dari field-field ini, tidak disimpan supaya tidak pernah basi.
model PayrollItem {
  id         Int           @id @default(autoincrement())
  periodId   Int
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee      @relation(fields: [employeeId], references: [id])

  // ringkasan absensi periode ini - referensi HR, ikut disimpan biar tidak
  // berubah kalau data absensi mentahnya diedit/diimpor ulang belakangan.
  daysPresent     Int @default(0)
  overtimeMinutes Int @default(0)

  baseSalary                   Int     @default(0) // gaji pokok bulanan (karyawan tetap)
  partTimePay                  Int     @default(0) // gaji harian x hari hadir (karyawan part time) - terpisah dari gaji pokok
  mealAllowance                Int     @default(0) // uang makan
  transportReimbursement       Int     @default(0) // reimbursement transport (kantor)
  overtimePay                  Int     @default(0) // lembur
  attendanceDeduction          Int     @default(0) // potongan alpha/telat
  bpjsKesehatanDeduction       Int     @default(0)
  bpjsKetenagakerjaanDeduction Int     @default(0)
  pph21Deduction               Int     @default(0)
  loanDeduction                Int     @default(0) // kasbon/potongan pinjaman
  otherAdjustment              Int     @default(0) // penyesuaian manual lain (boleh minus)
  note                         String?

  // Kategori tambahan khusus Payroll Outlet, ikut logika spreadsheet gaji
  // outlet yang sudah berjalan (permintaan Kevin 2026-09-11) - tidak
  // otomatis terisi (tidak ada sumber datanya di sistem), HR isi manual
  // per periode.
  lateCount              Int @default(0) // jumlah kejadian terlambat (bukan rupiah, referensi HR)
  lateDeduction          Int @default(0) // potongan telat = lateCount x rate keterlambatan
  incidentDeduction      Int @default(0) // Pengurangan Dari Kejadian (nominal per insiden, mis. alat rusak)
  warningLetterDeduction Int @default(0) // Pemotongan SP (surat peringatan)
  depositDeduction       Int @default(0) // Pembayaran Deposit (cicilan deposit karyawan)
  depositRefund          Int @default(0) // Pengembalian Deposit (refund, penambah)
  serviceCharge          Int @default(0) // Service Charge (bagi hasil tip, penambah)
  bonus                  Int @default(0)

  // Kategori tambahan khusus Payroll Kantor, ikut logika spreadsheet gaji
  // kantor "2608 rekap gaji FINAL.xlsx" (permintaan Kevin 2026-09-13) -
  // tidak tampil di Outlet. bonusSales & fuelKm sengaja manual (tidak ada
  // sumber datanya di sistem) - PPh21 & "Potongan" generik kantor pakai
  // field yang sudah ada (pph21Deduction, otherAdjustment). Keterlambatan &
  // Absen Tidak Lengkap DIHITUNG OTOMATIS dari absensi vs Employee.
  // workSchedule x rate (beda dari Outlet yang manual). fuelReimbursement
  // dihitung dari fuelKm x rate karyawan tapi SENGAJA TIDAK ikut Take Home
  // Pay (dibayar terpisah - sesuai sheet Recap Kevin, kolom "Reimburse"
  // berdiri sendiri di luar Total Penghasilan/Pengurang).
  bonusSales                  Int @default(0) // Bonus Atas Penjualan (kantor, manual per periode)
  incompleteClockInCount      Int @default(0) // jumlah hari absen tidak lengkap Clock In (kantor, dari absensi)
  incompleteClockInDeduction  Int @default(0) // = incompleteClockInCount x Employee.kantorIncompleteClockRate
  incompleteClockOutCount     Int @default(0)
  incompleteClockOutDeduction Int @default(0)
  bpjsAllowance               Int @default(0) // Tunjangan BPJS Kar (kantor, penambah) - saran dari Employee.kantorBpjsAllowance
  bpjsEmployerObligation      Int @default(0) // Kewajiban BPJS Ktr (kantor, penambah) - saran dari Employee.kantorBpjsEmployerObligation
  bpjsRemittance              Int @default(0) // Setoran ke BPJS (kantor, pengurang) - saran dari Employee.kantorBpjsRemittance
  fuelKm                      Int @default(0) // KM ditempuh bulan ini (kantor, input manual - tidak ada sumber data GPS/mileage)
  fuelReimbursement           Int @default(0) // = fuelKm x Employee.kantorFuelRatePerKm - DI LUAR Take Home Pay

  @@unique([periodId, employeeId])
}

// Omzet harian per outlet, disinkronkan MANUAL (tombol "Sync Sekarang") dari
// sheet rekap penjualan POS ("Sales Recapitulation Detail Report") yang
// dibagikan Kevin - dipakai Cost Center hitung Gross Profit. "Omzet" =
// kolom "Total" di sheet (Subtotal + Service Charge 5%), BUKAN Nett
// Sales/Subtotal saja - keputusan Kevin 2026-09-12. outletName dicocokkan
// ke nama outlet HR (lib/payroll-config.ts OUTLET_NAMES) lewat mapping di
// lib/sales-sheet.ts, bukan dari kolom "Branch" mentah di sheet.
model DailySales {
  id         Int      @id @default(autoincrement())
  outletName String
  date       DateTime
  totalOmzet Int
  syncedAt   DateTime @default(now())

  @@unique([outletName, date])
}

// ===================== Accounting (double-entry) =====================
// Modul finansial formal pertama di sistem - COA + jurnal debit/kredit
// sungguhan, P&L/Neraca/Arus Kas DIHITUNG dari saldo jurnal (bukan agregat
// terpisah spt Cost Center). Permintaan & keputusan Kevin 2026-09-14, desain
// lengkap & urutan pembangunan ada di plan
// C:\Users\inu\.claude\plans\nifty-nibbling-treasure.md. Semua modul transaksi
// (Record Sales/COGS/Direct Expense/Depresiasi) WAJIB posting lewat 1 fungsi
// bersama (lib/accounting-ledger.ts postJournalEntry()) supaya invariant
// debit=kredit & lock periode konsisten di semua jalur - jangan pernah insert
// JournalEntry/JournalLine langsung dari route lain.
//
// outletName (String, BUKAN relasi) ikut konvensi yang sudah dipakai di
// seluruh schema ini (lihat Employee.outlet, DailySales.outletName) -
// dicocokkan ke lib/payroll-config.ts OUTLET_NAMES. TIDAK ada model Outlet di
// schema HR ini (Outlet aslinya cuma ada di database Warehouse, dibaca lewat
// jembatan read-only lib/warehouse-db.ts) jadi tidak bisa dibuat foreign key
// sungguhan ke situ.

model Account {
  id        Int       @id @default(autoincrement())
  code      String    @unique // mis. "1-1000", urutan tampil ikut kode ini
  name      String
  type      String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  subType   String? // mis. "Aset Lancar", "HPP", "Beban Operasional" - label pengelompokan laporan
  parentId  Int?
  parent    Account?  @relation("AccountChildren", fields: [parentId], references: [id])
  children  Account[] @relation("AccountChildren")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  journalLines JournalLine[]

  @@index([type])
}

// Header 1 transaksi jurnal (harus balance: total debit semua JournalLine di
// bawahnya = total kredit). sourceType+sourceId dipakai modul lain (Record
// Sales/COGS/Direct Expense/Depresiasi) sbg kunci idempoten - re-sync SELALU
// hapus+buat ulang entry lama dgn sourceType+sourceId yang sama dalam 1
// transaksi, TIDAK PERNAH numpuk dobel entry utk sumber+tanggal yang sama
// (pola sama spt tombol "Sync Sekarang" Cost Center yang sudah ada).
model JournalEntry {
  id           Int            @id @default(autoincrement())
  date         DateTime
  memo         String
  sourceType   String // RECORD_SALES | COGS_SYNC | DIRECT_EXPENSE | DEPRECIATION | BANK_ADJUSTMENT | OPENING_BALANCE | MANUAL
  sourceId     String? // mis. "GS-2026-09-14" - kunci idempoten per sourceType
  outletName   String? // null = lintas outlet/konsolidasi
  createdById  Int?
  createdBy    HrUser?        @relation(fields: [createdById], references: [id])
  isLocked     Boolean        @default(false) // true kalau AccountingPeriod tanggal ini sudah dikunci
  reversalOfId Int?
  reversalOf   JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals    JournalEntry[] @relation("JournalReversal")
  createdAt    DateTime       @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Int          @default(0) // salah satu (debit/credit) selalu 0 - lebih gampang di-query drpd signed amount+arah
  credit         Int          @default(0)
  outletName     String? // override level baris (beda dari JournalEntry.outletName) - utk 1 entry yang perlu dipecah lintas outlet
  contactId      Int?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  description    String?

  @@index([accountId])
}

// Penguncian periode (per bulan) - periode yang sudah final menolak jurnal
// baru bertanggal di dalamnya, pola sama spt PayrollPeriod.status draft/final
// yang sudah ada. Dicek di postJournalEntry() sebelum insert.
model AccountingPeriod {
  id        Int       @id @default(autoincrement())
  yearMonth String    @unique // "2026-09"
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
}

model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  type       String // CUSTOMER | VENDOR | EMPLOYEE | OTHER
  // Kontak tipe EMPLOYEE disinkron dari tabel Employee HR (permintaan Kevin
  // 2026-09-15: "masukan semua daftar kontak karyawan, ikuti statusnya") -
  // employeeId jadi kunci idempoten sync (nama boleh berubah, tetap 1
  // kontak). isActive ikut Employee.status (resigned = nonaktif).
  employeeId Int?     @unique
  phone      String?
  email      String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  journalLines   JournalLine[]
  directExpenses DirectExpense[]

  @@index([type])
}

// Dokumen sumber Direct Expense (1 bon/nota = 1 record, bisa beberapa baris
// item ke akun beban berbeda) - posting ke JournalEntry (Dr tiap akun beban
// baris, Cr akun Kas/Bank pembayaran) lewat lib/accounting-ledger.ts.
// Foto bon dibaca OCR Claude (pola sama spt scan-bon Belanja Warehouse,
// permintaan Kevin 2026-09-14) lalu disimpan sbg receiptUrl (Vercel Blob)
// utk jejak audit. v1 asumsi lunas saat itu juga (belum ada status Utang
// Usaha/AP menunggu bayar - keterbatasan v1 yang disengaja, lihat plan).
model DirectExpense {
  id               Int      @id @default(autoincrement())
  date             DateTime
  contactId        Int?
  contact          Contact? @relation(fields: [contactId], references: [id])
  outletName       String?
  paymentAccountId Int // akun Kas/Bank yang dikredit
  amount           Int // total semua baris
  description      String?
  receiptUrl       String?
  journalEntryId   Int?     @unique
  createdById      Int?
  createdBy        HrUser?  @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())

  lines DirectExpenseLine[]
}

model DirectExpenseLine {
  id              Int           @id @default(autoincrement())
  directExpenseId Int
  directExpense   DirectExpense @relation(fields: [directExpenseId], references: [id], onDelete: Cascade)
  description     String
  amount          Int
  accountId       Int // akun beban yang didebit utk baris ini
}

// Foto item katalog Warehouse - disimpan di sisi ERP (bukan nulis ke tabel
// Item Warehouse, jembatan ke sana BACA SAJA) keyed by id Item Warehouse.
// Permintaan Kevin 2026-09-14 ("upload foto agar bisa mengetahui dengan
// jelas barang yang dimaksud apa").
model ProductPhoto {
  id              Int      @id @default(autoincrement())
  warehouseItemId Int      @unique
  url             String
  createdAt       DateTime @default(now())
}

// Catatan atas Laporan Keuangan (CALK) - v1 teks bebas per periode bulan,
// ditulis manual (bukan auto-generate), lihat plan.
model AccountingNote {
  id        Int      @id @default(autoincrement())
  yearMonth String   @unique // "2026-09"
  content   String
  updatedAt DateTime @updatedAt
}

// Depresiasi garis lurus (straight-line) saja utk v1 - keputusan Kevin
// 2026-09-14. Mulai KOSONG (tidak ada migrasi aset lama), diisi manual kapan
// Kevin siap. accountId/accumDepreciationAccountId/depreciationExpenseAccountId
// menunjuk ke Account (COA) yang relevan - divalidasi di UI (bukan foreign
// key bertipe, supaya 1 aset bisa pilih akun beda2 kalau perlu).
model FixedAsset {
  id                           Int      @id @default(autoincrement())
  name                         String
  category                     String
  acquisitionDate              DateTime
  acquisitionCost              Int
  usefulLifeMonths             Int
  residualValue                Int      @default(0)
  assetAccountId               Int
  accumDepreciationAccountId   Int
  depreciationExpenseAccountId Int
  isActive                     Boolean  @default(true)
  createdAt                    DateTime @default(now())

  depreciationEntries FixedAssetDepreciation[]
}

// 1 baris = 1 bulan posting depresiasi utk 1 aset - @@unique mencegah dobel
// posting bulan yang sama (idempoten, sama spt pola sync lain di modul ini).
model FixedAssetDepreciation {
  id             Int        @id @default(autoincrement())
  fixedAssetId   Int
  fixedAsset     FixedAsset @relation(fields: [fixedAssetId], references: [id])
  yearMonth      String // "2026-09"
  amount         Int
  journalEntryId Int?       @unique
  createdAt      DateTime   @default(now())

  @@unique([fixedAssetId, yearMonth])
}

model BankAccount {
  id            Int     @id @default(autoincrement())
  name          String
  accountId     Int // akun Kas/Bank terkait di COA
  bankName      String?
  accountNumber String?
  isActive      Boolean @default(true)

  statementLines  BankStatementLine[]
  invoicesPaidVia Invoice[]
}

// Baris mutasi rekening koran (impor CSV atau input manual) - dicocokkan
// manual ke JournalLine akun Kas/Bank yang belum matched lewat UI Rekonsiliasi.
model BankStatementLine {
  id                   Int         @id @default(autoincrement())
  bankAccountId        Int
  bankAccount          BankAccount @relation(fields: [bankAccountId], references: [id])
  date                 DateTime
  description          String
  amount               Int // + masuk, - keluar
  balance              Int? // saldo berjalan per baris, APA ADANYA dari sumber (rekening koran) - referensi, bukan dihitung ulang
  matchedJournalLineId Int?        @unique
  createdAt            DateTime    @default(now())
}

// Rincian Record Sales per produk per hari - diisi dgn memperluas
// lib/sales-sheet.ts supaya juga keluarkan baris per "Menu" (bukan cuma total
// harian spt DailySales). menuName teks bebas APA ADANYA dari sheet POS,
// SENGAJA belum dipetakan ke Product/Item Warehouse (keputusan Kevin
// 2026-09-14 - lihat plan). 1 SalesRecord per outlet per hari, posting 1
// JournalEntry (Dr Kas/Piutang, Cr Pendapatan Penjualan).
model SalesRecord {
  id             Int      @id @default(autoincrement())
  date           DateTime
  outletName     String
  source         String   @default("SHEET_IMPORT") // SHEET_IMPORT | MANUAL
  total          Int      @default(0) // total omzet hari itu (dari tab "daily" sheet POS) - dasar jurnal Dr AR / Cr Sales
  journalEntryId Int?     @unique
  createdAt      DateTime @default(now())

  lines SalesRecordLine[]

  @@unique([outletName, date])
}

model SalesRecordLine {
  id            Int         @id @default(autoincrement())
  salesRecordId Int
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id], onDelete: Cascade)
  menuName      String
  qty           Int
  unitPrice     Int
  subtotal      Int
  serviceCharge Int         @default(0)
  total         Int
}

// ==================== Modul Invoicing (permintaan Kevin 2026-09-15) ====================
// Invoice manual per cabang, dikirim ke WhatsApp customer, dibayar via QRIS
// dinamis (Midtrans Core API - lihat lib/midtrans.ts). Item yang bisa dijual = SEMUA item
// Warehouse dgn SKU berawalan "ESB" (keputusan Kevin), dibaca live lewat
// jembatan lib/warehouse-db.ts (sama pola dgn modul Product Accounting) -
// TIDAK ada tabel produk lokal, cuma snapshot sku/nama/satuan per baris
// invoice (InvoiceLine) supaya riwayat invoice lama tidak berubah kalau item
// Warehouse-nya diedit belakangan. Akses owner/developer saja
// (lib/roles.ts canAccessInvoicing) - modul finansial customer-facing,
// sama level sensitifnya dgn Accounting.

// Harga JUAL ke customer per item ESB - SENGAJA TERPISAH dari
// standardCost/FIFO Warehouse (itu harga POKOK/modal, bukan harga jual).
// Diatur manual di halaman Invoicing > Harga Jual Menu, key = Item.id
// Warehouse.
model InvoiceItemPrice {
  id              Int      @id @default(autoincrement())
  warehouseItemId Int      @unique
  sku             String // snapshot referensi cepat, bukan sumber kebenaran (Warehouse tetap sumbernya)
  price           Int
  updatedById     Int?
  updatedBy       HrUser?  @relation("InvoicePriceUpdatedBy", fields: [updatedById], references: [id])
  updatedAt       DateTime @updatedAt
}

// Nomor urut invoice per cabang per bulan (reset tiap bulan) - key
// `${branchCode}:${yyMM}`, mis. "GS:2609". Increment atomik dlm transaksi
// saat invoice dibuat (lib/invoice-numbering.ts) supaya tidak pernah
// tabrakan nomor walau 2 invoice dibuat bersamaan.
model InvoiceCounter {
  key     String @id
  lastSeq Int    @default(0)
}

model Invoice {
  id          Int      @id @default(autoincrement())
  number      String   @unique // format: INV/<branchCode>/<yyMM>/<seq 4 digit>, mis. INV/GS/2609/0001
  branchCode  String // GS | KG | FTG | JGL | KTR - lihat lib/invoicing-config.ts
  invoiceDate DateTime // default hari ini saat dibuat, bisa diubah

  customerName    String
  customerPhone   String // nomor WA customer, format bebas - dinormalisasi saat kirim (lib/whatsapp.ts)
  customerAddress String?
  notes           String?

  subtotal Int
  discount Int @default(0)
  total    Int

  status String @default("unpaid") // unpaid | paid | cancelled

  // Token akses halaman publik /invoice/[token] (dikirim ke WhatsApp
  // customer) - tanpa login, sama pola dgn Candidate.publicToken.
  publicToken String @unique @default(uuid())

  // QRIS dinamis (Midtrans Core API, charge payment_type "qris") - null
  // selama belum digenerate / MIDTRANS_SERVER_KEY belum diset di server.
  // order_id yang dikirim ke Midtrans = "INV-<Invoice.id>" (bukan `number`,
  // krn `number` pakai "/" yang tidak valid utk order_id Midtrans).
  midtransOrderId    String? // "INV-<id>" - dipakai jg utk cocokkan webhook masuk
  midtransQrString   String? // raw EMV QR string dari response Midtrans (backup/referensi)
  midtransQrImageUrl String? // URL gambar QR yang di-hosting Midtrans (actions[].url "generate-qr-code") - ditampilkan langsung via <img>
  midtransQrExpiresAt DateTime?

  paidAt            DateTime?
  paidMethod        String? // "midtrans_qris" | "manual"
  paidBankAccountId Int?
  paidBankAccount   BankAccount? @relation(fields: [paidBankAccountId], references: [id])
  paidById          Int?
  paidBy            HrUser?      @relation("InvoicePaidBy", fields: [paidById], references: [id])

  cancelledAt  DateTime?
  cancelReason String?

  // Dr AR-cabang / Cr Sales-cabang, dibuat saat invoice diterbitkan.
  journalEntryId        Int? @unique
  // Dr Bank(atau akun kliring Midtrans) / Cr AR-cabang, dibuat saat status jadi "paid".
  paymentJournalEntryId Int? @unique

  createdById Int?
  createdBy   HrUser?  @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines InvoiceLine[]

  @@index([branchCode, invoiceDate])
  @@index([status])
}

model InvoiceLine {
  id              Int     @id @default(autoincrement())
  invoiceId       Int
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  warehouseItemId Int
  sku             String
  name            String
  unit            String
  qty             Int
  unitPrice       Int
  subtotal        Int
}
